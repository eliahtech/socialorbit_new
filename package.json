{
  "name": "socialorbit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "SocialOrbit by ELIAHTECH \u2014 multi-tenant social publishing workspace",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "start": "npm run build:web && tsx apps/api/src/server.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run typecheck && npm test && npm run test:syntax",
    "mobile:sync": "cd apps/mobile && npx cap sync",
    "mobile:android": "cd apps/mobile && npx cap open android",
    "mobile:ios": "cd apps/mobile && npx cap open ios",
    "build:web": "node scripts/build-web.mjs",
    "build": "node scripts/build-web.mjs",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "bullmq": "^5.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "tsx": "^4.19.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
