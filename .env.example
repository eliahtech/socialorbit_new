# Copy to .env. The API fails closed if Supabase settings are missing.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
SUPABASE_MEDIA_BUCKET=socialorbit-media
# 32-byte key encoded as 64 hexadecimal characters. Generate with openssl rand -hex 32.
ENCRYPTION_KEY_HEX=
REDIS_URL=redis://127.0.0.1:6379
# Social OAuth: use provider-specific approved scopes. All credentials stay server-side.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Space-separated. youtube.upload lets SocialOrbit upload videos to the connected channel (reconnect YouTube after changing this).
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid,profile,w_member_social
# Publishing remains gated by the actual permissions of each connected account.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
# Payment providers: live checkout is disabled until credentials are configured.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_ENV=sandbox
# Currencies your Pesapal merchant account is approved to settle (KES default; add USD only if enabled by Pesapal).
PESAPAL_CURRENCIES=KES
# PayPal settles USD only. Create a REST app (sandbox first) and a webhook for <PUBLIC_BASE_URL>/api/webhooks/paypal
# subscribed to PAYMENT.CAPTURE.COMPLETED; put its ID below.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Worker safety: must explicitly enable before publishing external posts.
ENABLE_PUBLISHING=false
ENABLE_SOCIAL_SYNC=false
ENABLE_MEDIA_CLEANUP=true

# --- Vercel / serverless ---
# Shared rate limiting across serverless instances (Upstash Redis REST, or Vercel KV which uses the same variables).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for Vercel Cron endpoints (16+ random characters). Vercel sends it as a Bearer token automatically.
CRON_SECRET=
# true = /api/cron/publish-due publishes scheduled jobs directly (no worker). Needs a Vercel plan with frequent crons.
PUBLISH_VIA_CRON=false
# Administrators must have completed TOTP MFA (aal2). Set to false only for local development.
ADMIN_REQUIRE_MFA=true
